---
import Layout from "../layouts/Layout.astro";
import Subpage from "../layouts/Subpage.astro";
import Commit from "../components/Commit.astro";
import { Image } from "astro:assets";

import "../styles/global.css";
import bg1 from "../assets/bg1.png";

const allPosts = Object.values(
    import.meta.glob("./blog/*.md", { eager: true }),
);
---

<Layout>
    <div class="w-full">
        <!-- ===SUBPAGES===
        (would be seperate pages on most websites) -->
        <Subpage id="about-page" title="about me" closed="true">
            Thanks for stopping by! I'm Mart, a 16-year old hacker / high-schooler / mountain biker / follower of Christ / a bunch of other things.<br />

            I mainly do software, but I'm also getting into hardware recently. I really like creatively solving problems and coding with friends during hackathons. <br />

            When I'm not coding, I'm at school, cooking, or riding my mountain bike.

            I'm also part of Hack Club, a non-profit organisation that promotes coding for teens. It's awesome and I've made some of my best friends there! <br />

            <!-- 88x31s -->
            <div
                class="flex flex-row gap-1 flex-wrap justify-center max-w-full"
            >
                <img
                    src="https://cyber.dabamos.de/88x31/any2.gif"
                    alt="best viewed with any browser"
                />
                <img
                    src="https://cyber.dabamos.de/88x31/anythingbut.gif"
                    alt="Anything But Chrome"
                />
                <img
                    src="https://cyber.dabamos.de/88x31/besteyes2.gif"
                    alt="Best Viewed with Eyes"
                />
                <img
                    src="https://hex4.xyz/88x31/hackclub.png"
                    alt="Hack Club"
                />
                <img src="https://hex4.xyz/88x31/godot.png" alt="Godot" />
                <pagering-link theme="dark"></pagering-link>
            </div>
        </Subpage>

        <Subpage id="blog-page" title="blog" closed="true">
            A collection of my thoughts, ideas and experiences that are worth sharing.

            <ul class="mt-6 border-t border-white/30">
                {
                    allPosts.map((post: any) => (
                        <li class="flex flex-col gap-1 border-b border-white/30 py-4 sm:flex-row sm:items-baseline sm:justify-between sm:gap-6">
                            <div class="min-w-0">
                                <a
                                    href={post.url}
                                    class="break-words font-serif text-xl underline sm:text-2xl"
                                >
                                    {post.frontmatter.title}
                                </a>
                                <p class="break-words font-mono text-sm text-gray-300">
                                    {post.frontmatter.description}
                                </p>
                            </div>
                            <p class="shrink-0 font-mono text-xs text-gray-300">
                                written on
                                {new Date(
                                    post.frontmatter.pubDate,
                                ).toLocaleDateString()}
                            </p>
                        </li>
                    ))
                }
            </ul>
        </Subpage>

        <!-- ===MAIN PAGE CONTENT=== -->
        <div
            class="flex min-h-screen w-full flex-col items-center justify-center px-4 sm:px-6 md:px-4"
        >
            <p
                class="mb-2 py-2 text-center font-mono text-xs italic text-black sm:mb-4 sm:text-sm sm:py-4 md:mb-0 md:py-4"
                id="description"
            >
            </p>

            <!-- Mobile: name overlaid inside the image -->
            <div class="relative w-full max-w-sm sm:max-w-xl md:hidden">
                <Image
                    src={bg1}
                    alt="A background of a cityscape"
                    class="pointer-events-none h-auto w-full select-none"
                />
                <h1
                    class="absolute inset-0 z-10 flex items-center justify-center px-2 text-center font-mono text-3xl text-primary whitespace-nowrap sm:text-5xl"
                >
                    mart zielman
                </h1>
            </div>

            <!-- Desktop: original layout with the image beside the title -->
            <div class="hidden md:contents">
                <div class="relative">
                    <h1
                        class="py-4 text-center font-mono text-7xl text-primary lg:text-8xl"
                    >
                        mart zielman
                    </h1>
                </div>
                <Image
                    src={bg1}
                    alt="A background of a cityscape"
                    class="h-55 w-auto pointer-events-none md:absolute md:-mt-20 md:-ml-120"
                />
            </div>
            <p
                class="mt-6 flex flex-wrap items-center justify-center gap-x-1 gap-y-1 py-2 text-center font-serif text-sm text-black sm:mt-8 sm:text-base md:mt-6 md:block md:py-4"
            >
                <button
                    id="about"
                    class="nav-btn underline italic relative z-20 pointer-events-auto"
                    type="button">about me</button
                >
                ·
                <a
                    href="https://github.com/SwiftDust?tab=repositories"
                    class="underline italic relative z-20 pointer-events-auto"
                    >projects</a
                >
                ·
                <button
                    id="blog"
                    class="nav-btn underline italic relative z-20 pointer-events-auto"
                    type="button">blog</button
                >
                ·
                <button
                    id="contact"
                    class="nav-btn underline italic relative z-20 pointer-events-auto"
                    type="button"
                    ><a href="mailto:martzielman@proton.me">contact</a></button
                >
            </p>

            <div class="flex flex-row flex-wrap justify-center gap-3 sm:gap-4">
                <a
                    class="icon-[pixel--linkedin] h-8 w-8"
                    href="https://www.linkedin.com/in/mart-zielman/"
                    aria-label="LinkedIn"></a>
                <a
                    class="icon-[pixel--instagram] h-8 w-8"
                    href="https://www.instagram.com/mart.zielman/"
                    aria-label="Instagram"></a>
                <a
                    class="icon-[pixel--github] h-8 w-8"
                    href="https://github.com/SwiftDust"
                    aria-label="GitHub"></a>
                <button
                    class="icon-[pixel--discord] h-8 w-8"
                    data-tooltip-target="tooltip-default"
                    aria-label="Discord"
                >
                </button>
                <div
                    id="tooltip-default"
                    role="tooltip"
                    class="absolute z-10 invisible inline-block px-3 py-2 text-sm font-medium text-white transition-opacity duration-300 bg-gray-900 rounded-lg shadow-sm opacity-0 tooltip dark:bg-gray-700"
                >
                    @mart.txt
                    <div class="tooltip-arrow" data-popper-arrow></div>
                </div>
            </div>
            <div class="mt-8">
                <Commit />
            </div>
        </div>
    </div>
</Layout>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        const strings = [
            "professional idiot",
            "maker™",
            "addicted to mountainbiking & caffeine",
            "sleep deprived",
            "web and game developer",
            "refresh me for some fun stuff :)",
        ];

        let string = strings[Math.floor(Math.random() * strings.length)];

        const element = document.getElementById("description");
        if (element) {
            element.innerText = string;
        }
    });

    const navButtons = document.querySelectorAll(".nav-btn");

    for (const btn of navButtons) {
        btn.addEventListener("click", function (event) {
            event.preventDefault();
            const id = btn.getAttribute("id");
            if (!id) return;
            if (typeof window.openSubpage === "function") {
                window.openSubpage(`${id}-page`);
                return;
            }

            const subpage = document.getElementById(`${id}-page`);
            if (!subpage) return;
            subpage.classList.remove("is-closing");
            subpage.classList.remove("is-hidden");
            subpage.classList.add("is-visible");
        });
    }
</script>
