---
import Prose from "../components/Prose.astro";
import Layout from "../layouts/Layout.astro";
import "../styles/global.css";

const { frontmatter } = Astro.props;
---

<Layout>
    <meta charset="utf-8" />
    <div
        class="mx-auto mb-12 mt-12 flex w-full max-w-3xl flex-col items-center px-4 sm:mb-16 sm:mt-16 sm:px-6"
    >
        <div class="w-full">
            <h1
                class="font-serif text-3xl font-bold text-primary sm:text-4xl md:text-6xl"
            >
                {frontmatter.title}
            </h1>
            <div class="flex flex-row flex-wrap items-center gap-1 py-4">
                <p class="font-mono text-gray-500">
                    {frontmatter.pubDate.toString().slice(0, 10)}
                </p>
                ·
                <a href="/" class="font-mono text-gray-500 italic underline"
                    >back home</a
                >
            </div>
        </div>
        {frontmatter.image && (
            <img
                src={frontmatter.image.url}
                alt={frontmatter.image.alt}
                class="mt-6 aspect-video w-full max-w-2xl rounded-2xl object-cover shadow-2xl shadow-gray-200"
            />
        )}
        <Prose>
            <slot />
        </Prose>
    </div>
</Layout>
